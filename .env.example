# =====================================================================
#  Maryam Cosmetics & Beauty — environment variables
#  Copy this file to `.env` (local) or add the same keys in your host's
#  dashboard (Vercel → Project → Settings → Environment Variables).
#  NEVER commit the real .env file or share these values publicly.
# =====================================================================

# ---------- Database (REQUIRED) ----------
# Any PostgreSQL works: local Postgres, Supabase, Neon, Railway, Render...
# Supabase: Project Settings → Database → Connection string (use the "Session pooler" or direct string).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/maryam_store
# Set to true for hosted databases that require SSL (Supabase, Neon, Railway...)
DATABASE_SSL=false

# ---------- Site ----------
# Your public website URL (used for sitemap, SEO tags and links inside emails)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# ---------- Admin login ----------
# Option A (recommended): leave these empty, open /admin/setup once and create the owner account.
# Option B: set both and the owner account is created automatically on first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: require this key on /admin/setup so nobody else can claim the first admin account.
ADMIN_SETUP_KEY=
# Optional: secret used to sign admin sessions (min 16 chars). If empty, a random secret is generated and stored in the database.
SESSION_SECRET=

# ---------- Email (choose ONE provider) ----------
# Owner address that receives new-order emails (can also be changed in Admin → Store Settings)
OWNER_EMAIL=usmanih778@gmail.com

# Option 1 — Resend (https://resend.com): easiest, free tier available
RESEND_API_KEY=
# From address. With Resend you must verify your domain, e.g. "Maryam Cosmetics <orders@your-domain.com>".
# For quick tests Resend allows "Maryam Cosmetics <onboarding@resend.dev>" (only delivers to your own Resend account email).
EMAIL_FROM=

# Option 2 — SMTP (e.g. Gmail with an App Password: smtp.gmail.com, port 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ---------- Product image storage (OPTIONAL) ----------
# By default uploaded images are optimised and stored permanently inside PostgreSQL — nothing to configure.
# For a CDN-backed cloud bucket, configure ONE of the following:
# Cloudinary:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Supabase Storage (create a PUBLIC bucket first):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
